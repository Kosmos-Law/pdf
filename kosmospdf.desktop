[Desktop Entry]
Type=Application
Name=Kosmos PDF
GenericName=PDF Viewer and Editor
Comment=View, annotate, reorganise, OCR, redact and Bates-number PDFs
Exec=kosmospdf.sh %F
Icon=kosmospdf
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;image/png;image/jpeg;image/tiff;
StartupNotify=true
